<?xml version="1.0" encoding="utf-8"?>
<!--
  로컬 개발 서버(http)만 평문 통신을 허용한다.
  Android 9(API 28)부터 앱의 기본값이 "평문 차단"이라, 이 설정이 없으면
  http://10.0.2.2:8080 요청이 OkHttp 단계에서 UnknownServiceException 으로 죽는다
  (서버에는 요청이 도착하지 않고 앱에는 "네트워크 연결을 확인해주세요" 만 뜬다).
  운영 도메인은 여기 없으므로 https 만 허용된다.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>      <!-- 에뮬레이터에서 본 PC -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
