<?xml version="1.0" encoding="utf-8"?>
<!--
  debug 빌드 전용 오버라이드 (release 는 main 의 설정을 그대로 쓴다 — https 만 허용).

  왜 따로 두나: 시연용 EKS 는 도메인·인증서가 없어 ALB 주소가 http:// 다. main 설정은
  10.0.2.2 / localhost 만 평문을 허용하므로, 그 설정으로 빌드한 앱은 ALB 에 붙는 순간
  OkHttp 가 UnknownServiceException 으로 끊고 화면엔 "네트워크 연결을 확인해주세요" 만 뜬다.
  ALB 호스트는 배포가 끝나야 알 수 있어 도메인을 미리 적을 수도 없다.

  그래서 installDebug 로 설치하는 빌드에서만 평문을 전면 허용한다.
  release 빌드는 이 파일의 영향을 받지 않으므로 운영 정책(https 전용)은 그대로다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
